<Page x:Class="himchistka.practic.Views.UserProfilePage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      Title="UserProfilePage">
    <Grid Margin="24" Background="{StaticResource BrandPageBrush}">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <DockPanel Grid.Row="0" Margin="0,0,0,12" LastChildFill="False">
            <Button Content="Назад" Command="{Binding BackCommand}" Background="#EAF3FF" Foreground="{StaticResource BrandNavyBrush}" BorderBrush="#EAF3FF"/>
            <TextBlock Text="Информация о пользователе" FontSize="24" FontWeight="Bold" Margin="16,0,0,0" VerticalAlignment="Center" Foreground="{StaticResource BrandNavyBrush}"/>
        </DockPanel>

        <Border Grid.Row="1" Background="White" Padding="26" CornerRadius="20" BorderBrush="{StaticResource BrandLineBrush}" BorderThickness="1">
            <StackPanel>
                <TextBlock Text="ФИО" FontWeight="Bold" Foreground="{StaticResource BrandNavyBrush}"/>
                <TextBlock Text="{Binding FullName}" Margin="0,2,0,10" FontSize="15"/>

                <TextBlock Text="Email" FontWeight="Bold" Foreground="{StaticResource BrandNavyBrush}"/>
                <TextBlock Text="{Binding Email}" Margin="0,2,0,10" FontSize="15"/>

                <TextBlock Text="Телефон" FontWeight="Bold" Foreground="{StaticResource BrandNavyBrush}"/>
                <TextBlock Text="{Binding Phone}" Margin="0,2,0,10" FontSize="15"/>

                <TextBlock Text="Роль" FontWeight="Bold" Foreground="{StaticResource BrandNavyBrush}"/>
                <TextBlock Text="{Binding RoleName}" Margin="0,2,0,10" FontSize="15"/>
            </StackPanel>
        </Border>
    </Grid>
</Page>
