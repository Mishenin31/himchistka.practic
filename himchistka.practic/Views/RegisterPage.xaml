<Page x:Class="himchistka.practic.Views.RegisterPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      Title="RegisterPage">
    <Grid Background="{StaticResource BrandHeroBrush}">
        <Border Width="520" Padding="34" Background="White" CornerRadius="22" VerticalAlignment="Center" HorizontalAlignment="Center">
            <Border.Effect>
                <DropShadowEffect BlurRadius="30" ShadowDepth="8" Opacity="0.18" Color="#102A43"/>
            </Border.Effect>
            <StackPanel>
                <TextBlock Text="Создание аккаунта" FontSize="30" FontWeight="Bold" Foreground="{StaticResource BrandNavyBrush}"/>
                <TextBlock Text="Заполните данные клиента" Foreground="{StaticResource BrandMutedBrush}" Margin="0,4,0,18"/>
                <Button Content="Назад" Command="{Binding BackCommand}" HorizontalAlignment="Left" Background="#EAF3FF" Foreground="{StaticResource BrandNavyBrush}" BorderBrush="#EAF3FF" Margin="0,0,0,14"/>
                <TextBlock Text="ФИО" FontWeight="SemiBold"/><TextBox Margin="0,6,0,10" Text="{Binding FullName}"/>
                <TextBlock Text="Email" FontWeight="SemiBold"/><TextBox Margin="0,6,0,10" Text="{Binding Email}"/>
                <TextBlock Text="Телефон" FontWeight="SemiBold"/><TextBox Margin="0,6,0,10" Text="{Binding Phone}"/>
                <TextBlock Text="Пароль" FontWeight="SemiBold"/><TextBox Margin="0,6,0,22" Text="{Binding Password}"/>
                <Button Content="Зарегистрироваться" Command="{Binding RegisterCommand}" Height="40" Background="{StaticResource BrandHeroBrush}" BorderBrush="{StaticResource BrandBlueBrush}"/>
            </StackPanel>
        </Border>
    </Grid>
</Page>
