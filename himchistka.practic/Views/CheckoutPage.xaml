<Page x:Class="himchistka.practic.Views.CheckoutPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      Title="CheckoutPage">
    <Grid Margin="24" Background="{StaticResource BrandPageBrush}">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>
        <Button Content="Назад" Command="{Binding BackCommand}" HorizontalAlignment="Left" Background="#EAF3FF" Foreground="{StaticResource BrandNavyBrush}" BorderBrush="#EAF3FF" Margin="0,0,0,12"/>
        <Border Grid.Row="1" Padding="26" Background="White" BorderBrush="{StaticResource BrandLineBrush}" BorderThickness="1" CornerRadius="20">
            <Border.Effect>
                <DropShadowEffect BlurRadius="18" ShadowDepth="4" Opacity="0.08" Color="#102A43"/>
            </Border.Effect>
            <StackPanel>
                <TextBlock Text="Оформление заказа" FontSize="26" FontWeight="Bold" Foreground="{StaticResource BrandNavyBrush}" Margin="0,0,0,18"/>
                <TextBlock Text="Адрес выдачи" FontWeight="SemiBold"/><TextBox Margin="0,6,0,12" Text="{Binding Address}"/>
                <TextBlock Text="Способ оплаты" FontWeight="SemiBold"/><TextBox Margin="0,6,0,12" Text="{Binding PaymentMethod}"/>
                <TextBlock Text="Комментарий к изделию" FontWeight="SemiBold"/><TextBox Margin="0,6,0,22" Height="90" TextWrapping="Wrap" AcceptsReturn="True" Text="{Binding Comment}"/>
                <Button Content="Подтвердить" Command="{Binding PlaceOrderCommand}" HorizontalAlignment="Left" Background="{StaticResource BrandHeroBrush}" BorderBrush="{StaticResource BrandBlueBrush}"/>
            </StackPanel>
        </Border>
    </Grid>
</Page>
