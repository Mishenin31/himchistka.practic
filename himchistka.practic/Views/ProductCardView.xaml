<UserControl x:Class="himchistka.practic.Views.ProductCardView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Name="Root">
    <Border Margin="0,0,0,14" Padding="14" Background="White" BorderBrush="{StaticResource BrandLineBrush}" BorderThickness="1" CornerRadius="18">
        <Border.Effect>
            <DropShadowEffect BlurRadius="16" ShadowDepth="3" Opacity="0.07" Color="#102A43"/>
        </Border.Effect>
        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="148"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="148"/>
            </Grid.ColumnDefinitions>

            <Border Grid.Column="0" CornerRadius="14" ClipToBounds="True" Width="132" Height="100" VerticalAlignment="Center" Background="#EAF3FF">
                <Image Source="{Binding ImagePath}" Stretch="UniformToFill"/>
            </Border>

            <StackPanel Grid.Column="1" Margin="14,0,16,0" VerticalAlignment="Center">
                <TextBlock Text="{Binding Name}" FontWeight="Bold" FontSize="18" Foreground="{StaticResource BrandNavyBrush}"/>
                <TextBlock Text="{Binding Description}" Margin="0,8,0,10" TextWrapping="Wrap" Foreground="{StaticResource BrandMutedBrush}"/>
                <Border Background="{StaticResource BrandMintBrush}" CornerRadius="12" Padding="10,5" HorizontalAlignment="Left">
                    <TextBlock Text="{Binding Price, StringFormat={}{0:N0} ₽}" FontWeight="Bold" Foreground="{StaticResource BrandNavyBrush}"/>
                </Border>
            </StackPanel>

            <StackPanel Grid.Column="2" VerticalAlignment="Center" HorizontalAlignment="Stretch">
                <TextBlock Text="{Binding Stock, StringFormat=Свободно слотов: {0}}" Foreground="{StaticResource BrandMutedBrush}" TextAlignment="Center" Margin="0,0,0,10"/>
                <Button Content="В корзину"
                        Command="{Binding ElementName=Root, Path=AddToCartCommand}"
                        CommandParameter="{Binding}"
                        Background="{StaticResource BrandHeroBrush}"
                        BorderBrush="{StaticResource BrandBlueBrush}"/>
            </StackPanel>
        </Grid>
    </Border>
</UserControl>
