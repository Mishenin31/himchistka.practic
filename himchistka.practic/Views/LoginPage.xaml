<Page x:Class="himchistka.practic.Views.LoginPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      Title="LoginPage">
    <Grid Background="{StaticResource BrandHeroBrush}">
        <Border Width="440" Padding="34" Background="White" CornerRadius="22" VerticalAlignment="Center" HorizontalAlignment="Center">
            <Border.Effect>
                <DropShadowEffect BlurRadius="30" ShadowDepth="8" Opacity="0.18" Color="#102A43"/>
            </Border.Effect>
            <StackPanel>
                <Border Width="58" Height="58" CornerRadius="18" Background="{StaticResource BrandMintBrush}" HorizontalAlignment="Left" Margin="0,0,0,16">
                    <TextBlock Text="✦" FontSize="26" Foreground="{StaticResource BrandBlueBrush}" FontWeight="Bold" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                </Border>
                <TextBlock Text="Добро пожаловать" FontSize="30" FontWeight="Bold" Foreground="{StaticResource BrandNavyBrush}"/>
                <TextBlock Text="Войдите, чтобы продолжить работу с заказами" Foreground="{StaticResource BrandMutedBrush}" Margin="0,4,0,22"/>
                <TextBlock Text="Логин" FontWeight="SemiBold"/>
                <TextBox Margin="0,6,0,14" Text="{Binding Email, UpdateSourceTrigger=PropertyChanged}"/>
                <TextBlock Text="Пароль" FontWeight="SemiBold"/>
                <TextBox Margin="0,6,0,22" Text="{Binding Password, UpdateSourceTrigger=PropertyChanged}"/>
                <Button Content="Войти" Command="{Binding LoginCommand}" Height="40" Margin="0,0,0,10" Background="{StaticResource BrandHeroBrush}" BorderBrush="{StaticResource BrandBlueBrush}"/>
                <Button Content="Регистрация" Command="{Binding GoToRegisterCommand}" Height="38" Background="#EAF3FF" Foreground="{StaticResource BrandNavyBrush}" BorderBrush="#EAF3FF" />
            </StackPanel>
        </Border>
    </Grid>
</Page>
